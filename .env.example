NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional server-only override for Next.js rewrites. Defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_ORIGIN=

# Optional: run archive/realtime E2E against a deployed site instead of a local build.
E2E_BASE_URL=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
CRON_SECRET=replace-with-a-long-random-secret

# Configure one of these for movie search.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
