{
  "name": "couple-space",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:emoji": "node scripts/prepare-fluent-emojis.mjs",
    "predev": "npm run prepare:emoji",
    "dev": "next dev",
    "prebuild": "npm run prepare:emoji",
    "build": "next build",
    "predev:sites": "npm run prepare:emoji",
    "start": "next start",
    "dev:sites": "vinext dev",
    "prebuild:sites": "npm run prepare:emoji",
    "build:sites": "vinext build",
    "start:sites": "vinext start",
    "lint": "eslint app components lib tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify:vercel": "npm run check && npm run build",
    "verify:sites": "npm run build:sites",
    "supabase:start": "npx --yes supabase@2.111.0 start --exclude studio,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "npx --yes supabase@2.111.0 stop",
    "supabase:reset": "npx --yes supabase@2.111.0 db reset --local",
    "supabase:test": "npx --yes supabase@2.111.0 test db",
    "supabase:lint": "npx --yes supabase@2.111.0 db lint --local --level warning",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "test:e2e:archive-realtime": "playwright test --config=playwright.realtime.config.ts",
    "screenshots:mobile": "playwright test tests/mobile-screenshots.spec.ts"
  },
  "dependencies": {
    "@lobehub/fluent-emoji-3d": "1.1.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "emoji-regex": "10.4.0",
    "emojibase-data": "17.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^5.5.7",
    "react-server-dom-webpack": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@next/env": "16.2.11",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "0.35.0"
  },
  "type": "module"
}
